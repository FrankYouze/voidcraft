{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voidcraft",
  "version": "0.1.0",
  "identifier": "app.voidcraft.studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voidcraft",
        "width": 1440,
        "height": 920,
        "minWidth": 1140,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/voidcraft-generated/32x32.png",
      "icons/voidcraft-generated/128x128.png",
      "icons/voidcraft-generated/128x128@2x.png",
      "icons/voidcraft-generated/icon.icns",
      "icons/voidcraft-generated/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["vcraft"],
        "name": "Voidcraft Canvas",
        "description": "Voidcraft canvas file",
        "mimeType": "application/vnd.voidcraft.canvas+json",
        "role": "Editor",
        "exportedType": {
          "identifier": "app.voidcraft.studio.canvas",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "shortDescription": "Local database diagrams and whiteboards",
    "longDescription": "A local-first workspace for database schemas and freeform diagrams."
  }
}

